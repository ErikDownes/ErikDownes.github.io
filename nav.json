---
layout: null
permalink: /nav.json
---
[
{% assign nav_pages = site.pages | where_exp: "p", "p.top_nav == true" | sort: "nav_order" %}
{% assign first_nav_item = true %}
{% for p in nav_pages %}
  {% assign raw_title = p.title | default: '' %}
  {% assign title_parts = raw_title | split: '|' %}
  {% assign legacy_menu_title = title_parts[0] | strip %}
  {% assign menu_title = p.handle | default: legacy_menu_title | strip %}
  {% assign page_title = raw_title | strip %}
  {% if p.handle == nil and title_parts.size > 1 %}
    {% assign page_title = title_parts[1] | strip %}
  {% endif %}
  {% unless menu_title == 'General Questions' or menu_title == 'Competency / STAR' or menu_title == 'Pivotal Corporate Interview' or menu_title == 'UL CV' or menu_title == 'Results' or menu_title == 'Job Spec' %}
    {% unless first_nav_item %},{% endunless %}
{"title": {{ menu_title | jsonify }}, "page_title": {{ page_title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "order": {{ p.nav_order | jsonify }}}
    {% assign first_nav_item = false %}
  {% endunless %}
{% endfor %}
]
