---
layout: null
permalink: /nav.json
---
[
{% assign nav_pages = site.pages | where_exp: "p", "p.nav_order and p.handle != 'General Questions' and p.handle != 'Competency / STAR' and p.handle != 'Pivotal Corporate Interview'" | sort: "nav_order" %}
{% for p in nav_pages %}
  {% assign raw_title = p.title | default: '' %}
  {% assign title_parts = raw_title | split: '|' %}
  {% assign legacy_menu_title = title_parts[0] | strip %}
  {% assign menu_title = p.handle | default: legacy_menu_title | strip %}
  {% assign page_title = raw_title | strip %}
  {% if p.handle == nil and title_parts.size > 1 %}
    {% assign page_title = title_parts[1] | strip %}
  {% endif %}
  {% if menu_title == 'UL CV' %}
  {"title": "Job Spec", "page_title": "Job Spec", "url": "{{ p.url | relative_url }}#job-spec", "order": 39},
  {% endif %}
  {"title": {{ menu_title | jsonify }}, "page_title": {{ page_title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "order": {{ p.nav_order | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
